<Window x:Class="SatisfactoryPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SatisfactoryPlanner"
        mc:Ignorable="d"
        Title="Satisfactory Planner" Height="800" Width="1200"
        Background="#FF2B2B2B">
    <Grid>
        <!-- Status Bar -->
        <DockPanel>
            <ToolBarTray DockPanel.Dock="Right" Background="#FF3C3C3C" Orientation="Vertical">
                <ToolBar x:Name="BuildingToolBar" Background="#FF3C3C3C">
                </ToolBar>
                
                <!-- Help Panel -->
                <Border Background="#FF2B2B2B" BorderBrush="#FF555555" BorderThickness="1" Margin="5" Padding="10">
                    <StackPanel>
                        <TextBlock Foreground="Yellow" FontWeight="Bold" FontSize="12" Margin="0,0,0,5">Quick Help:</TextBlock>
                        <TextBlock Foreground="White" FontSize="10" TextWrapping="Wrap">
                            <Run>• Double-click buildings to select recipes</Run><LineBreak/>
                            <Run>• Double-click Source to configure item/rate</Run><LineBreak/>
                            <Run>• Yellow belts = valid, Red = invalid</Run><LineBreak/>
                            <Run>• Traffic shows on belt midpoint</Run><LineBreak/>
                            <Run>• R = rotate, Backspace = delete</Run><LineBreak/>
                            <Run>• Right-drag = pan, Wheel = zoom</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </ToolBarTray>
            
            <StatusBar DockPanel.Dock="Bottom" Background="#FF3C3C3C">
                <StatusBarItem>
                    <TextBlock x:Name="CoordinatesText" Foreground="White" Text="X: 0m, Y: 0m"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock x:Name="ZoomText" Foreground="White" Text="Zoom: 100%"/>
                </StatusBarItem>
            </StatusBar>
            
            <!-- Main Canvas Container -->
            <Border BorderBrush="#FF555555" BorderThickness="1">
                <Grid x:Name="CanvasContainer" ClipToBounds="True" Background="#FF1E1E1E">
                    <Canvas x:Name="MainCanvas"
                            Background="Transparent"
                            MouseWheel="MainCanvas_MouseWheel"
                            MouseDown="MainCanvas_MouseDown"
                            MouseMove="MainCanvas_MouseMove"
                            MouseUp="MainCanvas_MouseUp"
                            MouseLeave="MainCanvas_MouseLeave">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ScaleTransform"/>
                                <TranslateTransform x:Name="TranslateTransform"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
